# 論理クライアントのみ起動するときの例（ホストのエッジへ接続）
# コピーして編集するか、エッジ起動時に HFL_EXPORT_LOGICAL_CLIENT_ENV=1 で自動生成される
# docker/generated-logical-client.env を参照。

HFL_EDGE_URL_TERMINAL_00=http://host.docker.internal:8001
HFL_EDGE_URL_TERMINAL_01=http://host.docker.internal:8001
HFL_EDGE_URL_TERMINAL_02=http://host.docker.internal:8002
