# ================================================================
# docker/Dockerfile.central
# HFL セントラルサーバー (FastAPI + PyTorch CPU)
# ================================================================
# ビルドコンテキスト: HFL/Serverside_HFL/
# 例: docker compose -f docker/docker-compose.yml build central
#     （リポジトリルートから）

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── PyTorch CPU-only ──
RUN pip install --no-cache-dir \
    torch==2.2.2 \
    --index-url https://download.pytorch.org/whl/cpu

# ── 依存パッケージ ──
COPY requirements.txt /tmp/req.txt
RUN grep -v "^torch" /tmp/req.txt | \
    pip install --no-cache-dir -r /dev/stdin

# ── サーバーコード ──
COPY . /app/

RUN mkdir -p /app/state /app/dist /app/received_edges /app/logs

# ── デフォルト環境変数 ──
ENV CENTRAL_SERVER_HOST=0.0.0.0 \
    CENTRAL_SERVER_PORT=8000 \
    CENTRAL_AGGREGATION_THRESHOLD=3 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
    CMD curl -f http://localhost:8000/ || exit 1

CMD ["python", "-m", "uvicorn", "central_server.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
